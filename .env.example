# === Shared environment template ===
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is git-ignored.

# ── Dataset & artifact paths ──────────────────────────────────────────────────
# Absolute path to the folder containing the 8 CIC-IDS2017 CSV files.
DATASET_DIR=d:\Hybrid Threat Analysis and Cyber Defence Support System\MachineLearningCSV\MachineLearningCVE

# Absolute path for saving trained model artifacts (versioned filenames only).
MODELS_DIR=d:\Hybrid Threat Analysis and Cyber Defence Support System\models

# Absolute path for saving evaluation outputs, metric reports, SHAP plots, etc.
ARTIFACTS_DIR=d:\Hybrid Threat Analysis and Cyber Defence Support System\artifacts

# ── Python ML service ─────────────────────────────────────────────────────────
# Port the FastAPI ML service listens on.
ML_SERVICE_PORT=8000

# ── Node / Express backend ────────────────────────────────────────────────────
# Port the Express orchestration layer listens on.
BACKEND_PORT=4000

# URL the backend uses to reach the FastAPI ML service.
FASTAPI_URL=http://localhost:8000

# MongoDB connection string (use Atlas URI for deployment).
MONGO_URI=mongodb://localhost:27017/hybrid_threat_db

# ── Google Gemini API (Phase 11+) ─────────────────────────────────────────────
# Obtain from https://ai.google.dev/gemini-api/docs
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (confirmed: Gemini 2.5 Flash as initial candidate).
GEMINI_MODEL=gemini-2.5-flash

# ── RAG / Chroma (Phase 10+) ──────────────────────────────────────────────────
# Directory where Chroma persists its vector database locally.
CHROMA_PERSIST_DIR=d:\Hybrid Threat Analysis and Cyber Defence Support System\artifacts\chroma_db

# Embedding model (CPU-only, offline — no API key required).
EMBEDDING_MODEL=all-MiniLM-L6-v2
